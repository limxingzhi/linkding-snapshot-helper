LINKDING_URL=https://linkd.example.com
LINKDING_TOKEN=your-api-token-here
LINKDING_TAG=Offline
PORT=8080
SNAPSHOT_DIR=/snapshots
LOG_DIR=/logs
SYNC_ON_START=true
# Comma-separated CIDRs trusted as admin (delete + sync). Unset/empty = allow all.
# Example: ADMIN_SUBNET=100.64.0.0/10 (Tailscale)
ADMIN_SUBNET=100.64.0.0/10
BASE_PATH=
